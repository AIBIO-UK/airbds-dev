.claude/

# Node deps for the converter TypeScript package
reviews/src/google-sheet-converter/node_modules/

# Bun lockfile — package-lock.json is the committed lockfile (Bun migrates from it)
reviews/src/google-sheet-converter/bun.lock
reviews/src/google-sheet-converter/bun.lockb

# Build output of the converter package (rebuilt on prepublishOnly)
reviews/src/google-sheet-converter/dist/

# Skill zips built at the repo root — by the build workflows in CI, by
# skills/src/scripts/build_skill_zip.py when run locally, and by the
# release/rechannel step. Covers every channel name (-development, -testing, …).
/airbds-assessment-skill.zip
/airbds-assessment-skill-*.zip

# Python bytecode cache (metric build tooling)
__pycache__/
*.pyc

